[Unit]
Description=ORICO CF1000 NAS Bay LED Daemon (uburico-lights)
Documentation=https://github.com/meatposes/uburico-lights
After=systemd-modules-load.service udev-settle.service
After=zfs-import.target
Wants=zfs-import.target
# Stop retrying after 5 failed starts in 5 minutes instead of looping forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/sbin/cf1000-ledd
Restart=on-failure
RestartSec=10

# Load the driver in case systemd-modules-load ran before it was available
ExecStartPre=-/sbin/modprobe orico_cf1000_leds
# Wait up to 10s for the kernel module to register sysfs nodes
ExecStartPre=/bin/sh -c 'for i in $(seq 1 10); do [ -e /sys/class/leds/cf1000:bay1:blue ] && exit 0; sleep 1; done; echo "cf1000 LED sysfs not found after 10s: is orico_cf1000_leds built for kernel $$(uname -r)? check: dkms status orico-cf1000-leds"; exit 1'

TimeoutStopSec=5
KillSignal=SIGTERM

# Security hardening
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/sys/class/leds
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
